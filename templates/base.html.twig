<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Vidéo-Club Elastic{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2290%22>🎬</text></svg>">
        
        {# Chargement de Bootstrap 5 pour un design propre #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        
        {# Chargement de FontAwesome pour les icônes #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

        {% block stylesheets %}
            <style>
                body { background-color: #f8f9fa; }
                .navbar { margin-bottom: 2rem; }
            </style>
        {% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>
        {% endblock %}
    </head>
    <body>
        {# Une petite barre de navigation pour faire pro #}
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="#"><i class="fas fa-film"></i> Vidéo-Club Admin</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link active" href="{{ path('app_video_stats') }}">Stats Emprunts</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        {# C'est ici que le contenu de stats.html.twig va s'injecter #}
        <main>
            {% block body %}{% endblock %}
        </main>

        <footer class="text-center mt-5 py-3 text-muted">
            <small>&copy; 2026 - My Video Club with Elasticsearch</small>
        </footer>
    </body>
</html>