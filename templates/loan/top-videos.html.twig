{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">
    <h1>Top 10 des Films les Plus Empruntés</h1>
    <p class="text-muted">Voici la liste des 10 films les plus populaires basés sur le nombre d'emprunts.</p>

    <table class="table table-striped mt-4">
        <thead class="table-dark">
            <tr>
                <th>Rang</th>
                <th>Titre du Film</th>
                <th>Nombre d'Emprunts</th>
            </tr>
        </thead>
        <tbody>
            {% for video in topVideos %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ video.key }}</td>
                <td>{{ video.doc_count }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="3" class="text-center text-muted">Aucun emprunt trouvé.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}