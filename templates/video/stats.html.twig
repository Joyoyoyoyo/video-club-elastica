{% extends 'base.html.twig' %}

{% block title %}Statistiques des Emprunts{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1><i class="fas fa-chart-bar"></i> Statistiques du Vidéo-Club</h1>
    <p class="text-muted">Recherchez un film pour voir son nombre total d'emprunts (Données Elasticsearch)</p>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="input-group mb-3">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" 
                       id="search-input" 
                       class="form-control form-control-lg" 
                       placeholder="Tapez le titre d'un film (ex: Le Parrain...)"
                       autocomplete="off">
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-8">
            <div id="loader" class="text-center d-none">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
            </div>

            <div id="results-container">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Titre du Film</th>
                            <th class="text-center">Nombre d'emprunts</th>
                        </tr>
                    </thead>
                    <tbody id="results-body">
                        <tr>
                            <td colspan="2" class="text-center text-muted">Commencez à taper pour voir les statistiques</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    const input = document.getElementById('search-input');
    const tbody = document.getElementById('results-body');
    const loader = document.getElementById('loader');
    let timeout = null;

    input.addEventListener('input', (e) => {
        const query = e.target.value;
        
        // On annule le compte à rebours précédent
        clearTimeout(timeout);

        // Si l'input est vide, on réinitialise le tableau
        if (query.length < 2) {
            tbody.innerHTML = '<tr><td colspan="2" class="text-center text-muted">Commencez à taper pour voir les statistiques</td></tr>';
            return;
        }

        // On lance un nouveau compte à rebours de 300ms (Debounce)
        timeout = setTimeout(() => {
            // Afficher le loader
            loader.classList.remove('d-none');
            
            // Appel à notre API Symfony
            // Note : Vérifie bien que l'URL correspond à ta route API (/api/video/search-stats)
            fetch(`/api/video/search-stats?q=${encodeURIComponent(query)}`)
                .then(response => {
                    if (!response.ok) throw new Error('Erreur réseau');
                    return response.json();
                })
                .then(data => {
                    loader.classList.add('d-none'); // Cacher le loader
                    tbody.innerHTML = ''; // Vider le tableau

                    if (data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="2" class="text-center">Aucun résultat trouvé</td></tr>';
                        return;
                    }

                    // Remplissage dynamique
                    data.forEach(item => {
                        const row = `
                            <tr>
                                <td>${item.key}</td>
                                <td class="text-center">
                                    <span class="badge bg-primary rounded-pill fs-6">
                                        ${item.doc_count}
                                    </span>
                                </td>
                            </tr>
                        `;
                        tbody.insertAdjacentHTML('beforeend', row);
                    });
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    loader.classList.add('d-none');
                    tbody.innerHTML = '<tr><td colspan="2" class="text-center text-danger">Erreur lors de la récupération des données</td></tr>';
                });
        }, 300); 
    });
</script>

<style>
    .badge { min-width: 50px; }
    #search-input:focus {
        box-shadow: 0 0 10px rgba(13, 110, 253, 0.25);
        border-color: #0d6efd;
    }
</style>
{% endblock %}